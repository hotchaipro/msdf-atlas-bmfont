//
// MSDF pixel shader for BMFont fonts generated by msdf-atlas-bmfont.
//
// Uniforms:
//   TextureSize     The atlas size in texels (common scaleW, scaleH).
//   PxRange         The width of the distance range in atlas texels (msdf distanceRange).
//   DistanceOffset  The signed distance, in atlas texels, added to every sample; positive values
//                   move the glyph edges outward. Set it to
//                     distanceRangeMiddle + embolden
//                   where distanceRangeMiddle comes from the msdf section (nonzero for atlases
//                   generated with -apxrange) and embolden is how far to move the edges, in
//                   pixels of the font's native size (info size), which are atlas texels. The
//                   edges can only move as far as the atlas encodes distances: keep
//                   DistanceOffset well inside +/- PxRange / 2, or the glyphs become blocky.
//
// The atlas texture must be loaded as linear (not sRGB), uncompressed, without premultiplied
// alpha and without mipmaps, and sampled with bilinear filtering and clamp addressing.
// Single-channel atlases (sdf, psdf) must be expanded to RGB (as PNG and WebP loaders do)
// rather than loaded as a single-channel (R8) texture.

uniform float2 TextureSize;
uniform float PxRange;
uniform float DistanceOffset;

Sampler2D SpriteTextureSampler;

struct VertexShaderOutput
{
	float4 Position : SV_POSITION;
	float4 Color : COLOR0;
	float2 TextureCoordinate : TEXCOORD0;
};

float Median(float a, float b, float c)
{
	return max(min(a, b), min(max(a, b), c));
}

[shader("pixel")]
float4 psMain(VertexShaderOutput input) : SV_Target
{
	float2 p = input.TextureCoordinate;

	// Atlas texels per screen pixel. Averaging the squared derivatives keeps the value the same
	// when the text is rotated, unlike the sum of fwidth. It is capped so that heavily minified
	// text stays legible, and kept away from zero.
	float2 dx = ddx(p) * TextureSize;
	float2 dy = ddy(p) * TextureSize;
	float texelsPerPixel = clamp(sqrt(0.5f * (dot(dx, dx) + dot(dy, dy))), 1.0e-5f, 0.25f * PxRange);

	float3 msd = SpriteTextureSampler.Sample(p).rgb;

	// Signed distance to the edge in atlas texels, positive inside the glyph.
	float signedDistance = (Median(msd.r, msd.g, msd.b) - 0.5f) * PxRange + DistanceOffset;

	// Convert to screen pixels, so the edge is anti-aliased across one pixel.
	float opacity = saturate(signedDistance / texelsPerPixel + 0.5f);

	return input.Color * opacity;
}
